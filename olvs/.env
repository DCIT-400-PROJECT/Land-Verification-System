# ─── Django Core ─────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-olvs-dev-secret-key-change-in-production-!@#$%^&*()
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ─────────────────────────────────────────────────────────────────
DB_NAME=olvs_db
DB_USER=olvs_user
DB_PASSWORD=olvs_password
DB_HOST=localhost
DB_PORT=5433

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Media / QR Codes ─────────────────────────────────────────────────────────
MEDIA_ROOT=media
MEDIA_URL=/media/

# ─── Rate Limiting ────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT=5/minute

FRONTEND_BASE_URL=http://localhost:3000